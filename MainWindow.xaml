<Window x:Class="BindingsAndTriggers.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:BindingsAndTriggers.Views"
        Title="Лабораторная 1 Петров В.А 24.16"
        Width="900" Height="680"
        MinWidth="700" MinHeight="500"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource PrimaryBrush}" Padding="20,12">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Лабораторная 1"
                           Foreground="White" FontSize="20" FontWeight="Bold"
                           VerticalAlignment="Center"/>
                <TextBlock Text=" — привязки и триггеры"
                           Foreground="#B0BEC5" FontSize="14"
                           VerticalAlignment="Center" Margin="8,0,0,0"/>
            </StackPanel>
        </Border>

        <TabControl Grid.Row="1">
            <TabItem Header="По умолчанию">
                <views:DefaultBindView DataContext="{Binding DefaultBind}"/>
            </TabItem>
            <TabItem Header="Двухсторонняя">
                <views:TwoWayBindView DataContext="{Binding TwoWayBind}"/>
            </TabItem>
            <TabItem Header="Одноразовая">
                <views:OneTimeBindView DataContext="{Binding OneTimeBind}"/>
            </TabItem>
            <TabItem Header="Односторонние">
                <views:OneWayBindView DataContext="{Binding OneWayBind}"/>
            </TabItem>
            <TabItem Header="Триггеры">
                <views:TriggersView DataContext="{Binding Triggers}"/>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
