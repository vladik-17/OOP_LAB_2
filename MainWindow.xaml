<Window x:Class="BindingsAndTriggers.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:BindingsAndTriggers.Views"
        xmlns:loc="clr-namespace:BindingsAndTriggers.Localization"
        Title="{Binding [AppTitle], Source={x:Static loc:Localizer.Instance}}"
        Width="900" Height="680"
        MinWidth="700" MinHeight="500"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource PrimaryBrush}" Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Заголовок приложения -->
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="{Binding [AppTitle], Source={x:Static loc:Localizer.Instance}}"
                               Foreground="White" FontSize="20" FontWeight="Bold"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding [AppSubtitle], Source={x:Static loc:Localizer.Instance}}"
                               Foreground="#B0BEC5" FontSize="14"
                               VerticalAlignment="Center" Margin="8,0,0,0"/>
                </StackPanel>

                <!-- Переключатель языка -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding [LangLabel], Source={x:Static loc:Localizer.Instance}}"
                               Foreground="White" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox ItemsSource="{Binding Languages}"
                              SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}"
                              Width="90" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <TabControl Grid.Row="1">
            <TabItem Header="{Binding [Tab_Default], Source={x:Static loc:Localizer.Instance}}">
                <views:DefaultBindView DataContext="{Binding DefaultBind}"/>
            </TabItem>
            <TabItem Header="{Binding [Tab_TwoWay], Source={x:Static loc:Localizer.Instance}}">
                <views:TwoWayBindView DataContext="{Binding TwoWayBind}"/>
            </TabItem>
            <TabItem Header="{Binding [Tab_OneTime], Source={x:Static loc:Localizer.Instance}}">
                <views:OneTimeBindView DataContext="{Binding OneTimeBind}"/>
            </TabItem>
            <TabItem Header="{Binding [Tab_OneWay], Source={x:Static loc:Localizer.Instance}}">
                <views:OneWayBindView DataContext="{Binding OneWayBind}"/>
            </TabItem>
            <TabItem Header="{Binding [Tab_Triggers], Source={x:Static loc:Localizer.Instance}}">
                <views:TriggersView DataContext="{Binding Triggers}"/>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
