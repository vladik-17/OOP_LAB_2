<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>BindingsAndTriggers</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- CommunityToolkit.Mvvm генерирует VM через атрибуты -->
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- Явные логические имена для ResourceManager (SDK включает .resx автоматически) -->
    <EmbeddedResource Update="Resources\Strings.resx">
      <LogicalName>BindingsAndTriggers.Resources.Strings.resources</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Update="Resources\Strings.en.resx">
      <LogicalName>BindingsAndTriggers.Resources.Strings.en.resources</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
