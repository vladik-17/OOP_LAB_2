<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- WPF нужен для Binding.IndexerName и System.Windows.Data -->
    <UseWPF>true</UseWPF>
    <RootNamespace>LocalizationLib</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Явные логические имена чтобы ResourceManager нашёл ресурсы -->
    <EmbeddedResource Update="Strings.ru.resx">
      <LogicalName>LocalizationLib.Strings.ru.resources</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Update="Strings.en.resx">
      <LogicalName>LocalizationLib.Strings.en.resources</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
