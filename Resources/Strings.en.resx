  <!-- OneTime Binding -->
  <data name="OneTime_Title" xml:space="preserve"><value>One-Time Binding (OneTime)</value></data>
  <data name="OneTime_HowTitle" xml:space="preserve"><value>How does OneTime work?</value></data>
  <data name="OneTime_HowDesc" xml:space="preserve"><value>The value is read from ViewModel once — at element initialization.
Subsequent VM changes are not passed to the UI. Used for
static data: headers, initial values, immutable lists.</value></data>
  <data name="OneTime_CompareTitle" xml:space="preserve"><value>Comparison: OneTime vs OneWay</value></data>
  <data name="OneTime_CompareHint" xml:space="preserve"><value>Click the button — ViewModel updates. See which fields change:</value></data>
  <data name="OneTime_Label" xml:space="preserve"><value>OneTime (does not update after load):</value></data>
  <data name="OneWay_CompareLabel" xml:space="preserve"><value>OneWay (updates on each VM change):</value></data>
  <data name="OneTime_Button" xml:space="preserve"><value>Update ViewModel</value></data>
  <data name="OneTime_WhenTitle" xml:space="preserve"><value>When to use OneTime?</value></data>
  <data name="OneTime_WhenDesc" xml:space="preserve"><value>• Headers and labels that do not change at runtime
• Initial values from config or database
• ComboBox/ListBox sources with immutable lists
• Saves resources: no INotifyPropertyChanged subscription</value></data>

  <!-- OneWay Bindings -->
  <data name="OneWay_Title" xml:space="preserve"><value>One-Way Bindings (OneWay / OneWayToSource)</value></data>
  <data name="OneWay_TypesTitle" xml:space="preserve"><value>Two types of one-way binding</value></data>
  <data name="OneWay_Desc" xml:space="preserve"><value>VM → UI. Element only displays data from VM. Suitable for TextBlock, ProgressBar, Label.</value></data>
  <data name="OneWayToSource_Desc" xml:space="preserve"><value>UI → VM. Element only writes data to VM. VM does not send the value back to UI.</value></data>
  <data name="OneWay_SectionTitle" xml:space="preserve"><value>OneWay: ViewModel → UI</value></data>
  <data name="OneWay_SectionHint" xml:space="preserve"><value>Button changes VM. UI (OneWay) updates. Text cannot be changed manually:</value></data>
