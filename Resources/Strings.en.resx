  <!-- TwoWay Binding -->
  <data name="TwoWay_Title" xml:space="preserve"><value>Two-Way Binding (TwoWay)</value></data>
  <data name="TwoWay_HowTitle" xml:space="preserve"><value>How does TwoWay work?</value></data>
  <data name="TwoWay_HowDesc" xml:space="preserve"><value>Changes flow in both directions: UI → ViewModel and ViewModel → UI.
If one property is bound to multiple elements, they all stay in sync.</value></data>
  <data name="TwoWay_MultiTitle" xml:space="preserve"><value>Multiple TextBoxes — one property</value></data>
