  <!-- Привязка по умолчанию -->
  <data name="Default_Title" xml:space="preserve"><value>Привязка по умолчанию (Default)</value></data>
  <data name="Default_WhatTitle" xml:space="preserve"><value>Что такое Default-привязка?</value></data>
  <data name="Default_WhatDesc" xml:space="preserve"><value>Режим привязки по умолчанию зависит от элемента управления.
Для TextBox — TwoWay (обновляется при потере фокуса).
Для Slider — TwoWay (мгновенно).
Для CheckBox.IsChecked — TwoWay.
Для TextBlock — OneWay (только чтение).</value></data>
  <data name="Default_TextBoxTitle" xml:space="preserve"><value>TextBox — Default (TwoWay, LostFocus)</value></data>
  <data name="Default_TextBoxHint" xml:space="preserve"><value>Введите текст и нажмите Tab или кликните в другое место:</value></data>
  <data name="Default_VMValue" xml:space="preserve"><value>Значение в ViewModel:</value></data>
  <data name="Default_SliderTitle" xml:space="preserve"><value>Slider — Default (TwoWay)</value></data>
  <data name="Default_SliderHint" xml:space="preserve"><value>Перемещайте ползунок:</value></data>
  <data name="Default_SliderValue" xml:space="preserve"><value>Значение: </value></data>
