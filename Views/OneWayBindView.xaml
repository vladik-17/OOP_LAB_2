<UserControl x:Class="BindingsAndTriggers.Views.OneWayBindView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lib="clr-namespace:LocalizationLib;assembly=LocalizationLib">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
        <StackPanel MaxWidth="700" HorizontalAlignment="Left">

            <TextBlock Style="{StaticResource PageTitle}"
                       Text="{Binding [OneWay_Title], Source={x:Static lib:Translator.Instance}}"/>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}"
                               Text="{Binding [OneWay_TypesTitle], Source={x:Static lib:Translator.Instance}}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="#E8EAF6" CornerRadius="6" Padding="14">
                            <StackPanel>
                                <TextBlock FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"
                                           Text="OneWay" Margin="0,0,0,6"/>
                                <TextBlock TextWrapping="Wrap" FontSize="13"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           Text="{Binding [OneWay_Desc], Source={x:Static lib:Translator.Instance}}"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Background="#FCE4EC" CornerRadius="6" Padding="14">
                            <StackPanel>
                                <TextBlock FontWeight="Bold" Foreground="{StaticResource AccentBrush}"
                                           Text="OneWayToSource" Margin="0,0,0,6"/>
                                <TextBlock TextWrapping="Wrap" FontSize="13"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           Text="{Binding [OneWayToSource_Desc], Source={x:Static lib:Translator.Instance}}"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}"
                               Text="{Binding [OneWay_SectionTitle], Source={x:Static lib:Translator.Instance}}"/>
                    <TextBlock Style="{StaticResource Label}" TextWrapping="Wrap"
                               Text="{Binding [OneWay_SectionHint], Source={x:Static lib:Translator.Instance}}"/>
                    <TextBox Text="{Binding VmText, Mode=OneWay}"
                             IsReadOnly="True" Background="#F5F5F5"
                             Width="400" HorizontalAlignment="Left"/>

                    <TextBlock Style="{StaticResource Label}" Margin="0,12,0,4"
                               Text="{Binding [OneWay_ProgressHint], Source={x:Static lib:Translator.Instance}}"/>
                    <ProgressBar Value="{Binding Progress, Mode=OneWay}"
                                 Maximum="100" Height="14"
                                 Width="400" HorizontalAlignment="Left"
                                 Foreground="{StaticResource PrimaryBrush}"/>
                    <TextBlock Margin="0,4,0,0">
                        <Run Text="{Binding Progress, Mode=OneWay}"/>
                        <Run Text="%"/>
                    </TextBlock>

                    <Button Style="{StaticResource PrimaryButton}"
                            Command="{Binding UpdateVmTextCommand}"
                            Content="{Binding [OneWay_Button], Source={x:Static lib:Translator.Instance}}"
                            HorizontalAlignment="Left" Margin="0,12,0,0"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}"
                               Text="{Binding [OneWayToSource_Title], Source={x:Static lib:Translator.Instance}}"/>
                    <TextBlock Style="{StaticResource Label}" TextWrapping="Wrap"
                               Text="{Binding [OneWayToSource_Hint], Source={x:Static lib:Translator.Instance}}"/>
                    <TextBox Text="{Binding UiInput, Mode=OneWayToSource, UpdateSourceTrigger=PropertyChanged}"
                             Width="400" HorizontalAlignment="Left"
                             ToolTip="OneWayToSource: UI пишет в VM, VM не влияет на UI"/>

                    <TextBlock Style="{StaticResource Label}" Margin="0,12,0,4"
                               Text="{Binding [OneWayToSource_VMValue], Source={x:Static lib:Translator.Instance}}"/>
                    <TextBlock Style="{StaticResource ResultText}"
                               Text="{Binding UiInput, Mode=OneWay}"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource AccentBrush}"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
