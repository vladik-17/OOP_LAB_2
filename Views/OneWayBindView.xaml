<UserControl x:Class="BindingsAndTriggers.Views.OneWayBindView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
        <StackPanel MaxWidth="700" HorizontalAlignment="Left">

            <TextBlock Style="{StaticResource PageTitle}" Text="Односторонние привязки (OneWay / OneWayToSource)"/>

            <!-- Описание -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}" Text="Два варианта односторонней привязки"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="#E8EAF6" CornerRadius="6" Padding="14">
                            <StackPanel>
                                <TextBlock FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"
                                           Text="OneWay" Margin="0,0,0,6"/>
                                <TextBlock TextWrapping="Wrap" FontSize="13"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           Text="VM → UI. Элемент только отображает данные из VM. Подходит для TextBlock, ProgressBar, Label."/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Background="#FCE4EC" CornerRadius="6" Padding="14">
                            <StackPanel>
                                <TextBlock FontWeight="Bold" Foreground="{StaticResource AccentBrush}"
                                           Text="OneWayToSource" Margin="0,0,0,6"/>
                                <TextBlock TextWrapping="Wrap" FontSize="13"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           Text="UI → VM. Элемент только записывает данные в VM. VM не отправляет значение обратно в UI."/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- OneWay: VM → UI -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}" Text="OneWay: ViewModel → UI"/>
                    <TextBlock Style="{StaticResource Label}" TextWrapping="Wrap"
                               Text="Кнопка меняет VM. UI (OneWay) обновляется. Вручную текст изменить нельзя:"/>
                    <TextBox Text="{Binding VmText, Mode=OneWay}"
                             IsReadOnly="True" Background="#F5F5F5"
                             Width="400" HorizontalAlignment="Left"/>

                    <TextBlock Style="{StaticResource Label}" Margin="0,12,0,4"
                               Text="Прогресс (обновляется таймером каждую секунду):"/>
                    <ProgressBar Value="{Binding Progress, Mode=OneWay}"
                                 Maximum="100" Height="14"
                                 Width="400" HorizontalAlignment="Left"
                                 Foreground="{StaticResource PrimaryBrush}"/>
                    <TextBlock Margin="0,4,0,0">
                        <Run Text="{Binding Progress, Mode=OneWay}"/>
                        <Run Text="%"/>
                    </TextBlock>

                    <Button Style="{StaticResource PrimaryButton}"
                            Command="{Binding UpdateVmTextCommand}"
                            Content="Обновить текст из VM"
                            HorizontalAlignment="Left" Margin="0,12,0,0"/>
                </StackPanel>
            </Border>

            <!-- OneWayToSource: UI → VM -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}" Text="OneWayToSource: UI → ViewModel"/>
                    <TextBlock Style="{StaticResource Label}" TextWrapping="Wrap"
                               Text="Вводите текст — он записывается в VM. VM не отправляет его обратно в TextBox (поэтому поле не очищается из кода):"/>
                    <TextBox Text="{Binding UiInput, Mode=OneWayToSource, UpdateSourceTrigger=PropertyChanged}"
                             Width="400" HorizontalAlignment="Left"
                             ToolTip="OneWayToSource: UI пишет в VM, VM не влияет на UI"/>

                    <TextBlock Style="{StaticResource Label}" Margin="0,12,0,4"
                               Text="Значение в ViewModel (OneWay из VM):"/>
                    <TextBlock Style="{StaticResource ResultText}"
                               Text="{Binding UiInput, Mode=OneWay}"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource AccentBrush}"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
