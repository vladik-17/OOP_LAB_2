<UserControl x:Class="BindingsAndTriggers.Views.DefaultBindView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
        <StackPanel MaxWidth="700" HorizontalAlignment="Left">

            <TextBlock Style="{StaticResource PageTitle}" Text="Привязка по умолчанию (Default)"/>

            <!-- Описание -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}" Text="Что такое Default-привязка?"/>
                    <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}">
                        Режим привязки по умолчанию зависит от элемента управления.
                        Для TextBox — TwoWay (обновляется при потере фокуса).
                        Для Slider — TwoWay (мгновенно).
                        Для CheckBox.IsChecked — TwoWay.
                        Для TextBlock — OneWay (только чтение).
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- TextBox -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}" Text="TextBox — Default (TwoWay, LostFocus)"/>
                    <TextBlock Style="{StaticResource Label}" Text="Введите текст и нажмите Tab или кликните в другое место:"/>
                    <TextBox Text="{Binding InputText}" Width="350" HorizontalAlignment="Left"/>
                    <TextBlock Style="{StaticResource Label}" Margin="0,12,0,4" Text="Значение в ViewModel:"/>
                    <TextBlock Style="{StaticResource ResultText}"
                               Text="{Binding InputText, Mode=OneWay}"
                               FontWeight="SemiBold"/>
                </StackPanel>
            </Border>

            <!-- Slider -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}" Text="Slider — Default (TwoWay)"/>
                    <TextBlock Style="{StaticResource Label}" Text="Перемещайте ползунок:"/>
                    <Slider Minimum="0" Maximum="100"
                            Value="{Binding SliderValue}"
                            Width="350" HorizontalAlignment="Left"/>
                    <TextBlock Margin="0,8,0,0">
                        <Run Text="Значение: "/>
                        <Run Text="{Binding SliderValue, Mode=OneWay}"
                             FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"/>
                    </TextBlock>
                    <ProgressBar Value="{Binding SliderValue, Mode=OneWay}"
                                 Maximum="100" Height="10"
                                 Width="350" HorizontalAlignment="Left"
                                 Margin="0,8,0,0"
                                 Foreground="{StaticResource PrimaryBrush}"/>
                </StackPanel>
            </Border>

            <!-- CheckBox -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}" Text="CheckBox — Default (TwoWay)"/>
                    <CheckBox IsChecked="{Binding IsChecked}" Content="Активировать"/>
                    <TextBlock Style="{StaticResource ResultText}" Margin="0,8,0,0">
                        <Run Text="Статус: "/>
                        <Run Text="{Binding CheckStatus, Mode=OneWay}" FontWeight="Bold"/>
                    </TextBlock>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
