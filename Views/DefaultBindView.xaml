<UserControl x:Class="BindingsAndTriggers.Views.DefaultBindView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
        <StackPanel MaxWidth="700" HorizontalAlignment="Left">

            <TextBlock Style="{StaticResource PageTitle}" Text="{DynamicResource Default_Title}"/>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}" Text="{DynamicResource Default_WhatTitle}"/>
                    <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}"
                               Text="{DynamicResource Default_WhatDesc}"/>
                </StackPanel>
            </Border>

            <!-- TextBox -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}" Text="{DynamicResource Default_TextBoxTitle}"/>
                    <TextBlock Style="{StaticResource Label}" Text="{DynamicResource Default_TextBoxHint}"/>
                    <TextBox Text="{Binding InputText}" Width="350" HorizontalAlignment="Left"/>
                    <TextBlock Style="{StaticResource Label}" Margin="0,12,0,4"
                               Text="{DynamicResource Default_VMValue}"/>
                    <TextBlock Style="{StaticResource ResultText}"
                               Text="{Binding InputText, Mode=OneWay}" FontWeight="SemiBold"/>
                </StackPanel>
            </Border>

            <!-- Slider -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}" Text="{DynamicResource Default_SliderTitle}"/>
                    <TextBlock Style="{StaticResource Label}" Text="{DynamicResource Default_SliderHint}"/>
                    <Slider Minimum="0" Maximum="100"
                            Value="{Binding SliderValue}"
                            Width="350" HorizontalAlignment="Left"/>
                    <TextBlock Margin="0,8,0,0">
                        <Run Text="{DynamicResource Default_SliderValue}"/>
                        <Run Text="{Binding SliderValue, Mode=OneWay}"
                             FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"/>
                    </TextBlock>
                    <ProgressBar Value="{Binding SliderValue, Mode=OneWay}"
                                 Maximum="100" Height="10"
                                 Width="350" HorizontalAlignment="Left"
                                 Margin="0,8,0,0"
                                 Foreground="{StaticResource PrimaryBrush}"/>
                </StackPanel>
            </Border>

            <!-- CheckBox -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}" Text="{DynamicResource Default_CheckTitle}"/>
                    <CheckBox IsChecked="{Binding IsChecked}" Content="{DynamicResource Default_CheckContent}"/>
                    <TextBlock Style="{StaticResource ResultText}" Margin="0,8,0,0">
                        <Run Text="{DynamicResource Default_Status}"/>
                        <Run Text="{Binding CheckStatus, Mode=OneWay}" FontWeight="Bold"/>
                    </TextBlock>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
