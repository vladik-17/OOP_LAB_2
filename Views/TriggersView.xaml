<UserControl x:Class="BindingsAndTriggers.Views.TriggersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:BindingsAndTriggers.Views"
             xmlns:loc="clr-namespace:BindingsAndTriggers.Localization">

    <UserControl.Resources>
        <local:ScoreConverter x:Key="ScoreConv"/>

        <!-- Trigger: меняет фон Border при наведении мыши -->
        <Style x:Key="HoverCard" TargetType="Border">
            <Setter Property="Background" Value="#E8EAF6"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#3F51B5"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
        <StackPanel MaxWidth="700" HorizontalAlignment="Left">

            <TextBlock Style="{StaticResource PageTitle}"
                       Text="{Binding [Triggers_Title], Source={x:Static loc:Localizer.Instance}}"/>

            <!-- Описание видов триггеров -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}"
                               Text="{Binding [Triggers_TypesTitle], Source={x:Static loc:Localizer.Instance}}"/>
                    <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" LineHeight="22"
                               Text="{Binding [Triggers_TypesDesc], Source={x:Static loc:Localizer.Instance}}"/>
                </StackPanel>
            </Border>

            <!-- 1. Trigger -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}"
                               Text="{Binding [Triggers_1Title], Source={x:Static loc:Localizer.Instance}}"/>
                    <TextBlock Style="{StaticResource Label}"
                               Text="{Binding [Triggers_1Hint], Source={x:Static loc:Localizer.Instance}}"/>
                    <Border Style="{StaticResource HoverCard}" Width="280"
                            HorizontalAlignment="Left" Margin="0,8,0,0">
                        <TextBlock HorizontalAlignment="Center" FontSize="14">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#3F51B5"/>
                                    <!-- Текст по умолчанию из RESX -->
                                    <Setter Property="Text"
                                            Value="{Binding [Triggers_HoverText], Source={x:Static loc:Localizer.Instance}}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMouseOver,
                                            RelativeSource={RelativeSource AncestorType=Border}}"
                                                     Value="True">
                                            <Setter Property="Foreground" Value="White"/>
                                            <!-- Текст при наведении из RESX -->
                                            <Setter Property="Text"
                                                    Value="{Binding [Triggers_HoverActive], Source={x:Static loc:Localizer.Instance}}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>
                </StackPanel>
            </Border>

            <!-- 2. DataTrigger -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}"
                               Text="{Binding [Triggers_2Title], Source={x:Static loc:Localizer.Instance}}"/>
                    <TextBlock Style="{StaticResource Label}"
                               Text="{Binding [Triggers_2Hint], Source={x:Static loc:Localizer.Instance}}"/>
                    <TextBox Text="{Binding InputText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Width="300" HorizontalAlignment="Left"/>

                    <Border Margin="0,10,0,0" Padding="12" CornerRadius="6"
                            Width="300" HorizontalAlignment="Left">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#E8F5E9"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding InputText}" Value="ошибка">
                                        <Setter Property="Background" Value="#FFEBEE"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock HorizontalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text"
                                            Value="{Binding [Triggers_OK], Source={x:Static loc:Localizer.Instance}}"/>
                                    <Setter Property="Foreground" Value="#2E7D32"/>
                                    <Setter Property="FontWeight" Value="Normal"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding InputText}" Value="ошибка">
                                            <Setter Property="Text"
                                                    Value="{Binding [Triggers_Error], Source={x:Static loc:Localizer.Instance}}"/>
                                            <Setter Property="Foreground" Value="#C62828"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>

                    <!-- DataTrigger + конвертер -->
                    <TextBlock Style="{StaticResource Label}" Margin="0,16,0,4"
                               Text="{Binding [Triggers_ScoreHint], Source={x:Static loc:Localizer.Instance}}"/>
                    <Slider Minimum="0" Maximum="100"
                            Value="{Binding Score, Mode=TwoWay}"
                            Width="300" HorizontalAlignment="Left"/>
                    <Border Padding="10,6" CornerRadius="4" Margin="0,8,0,0"
                            Width="160" HorizontalAlignment="Left">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#43A047"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Score, Converter={StaticResource ScoreConv}}"
                                                 Value="low">
                                        <Setter Property="Background" Value="#E53935"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Score, Converter={StaticResource ScoreConv}}"
                                                 Value="mid">
                                        <Setter Property="Background" Value="#FB8C00"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Foreground="White" FontWeight="Bold" HorizontalAlignment="Center">
                            <Run Text="{Binding Score, StringFormat={}{0:F0}, Mode=OneWay}"/>
                            <Run Text="{Binding [Triggers_ScoreSuffix], Source={x:Static loc:Localizer.Instance}, Mode=OneWay}"/>
                        </TextBlock>
                    </Border>
                </StackPanel>
            </Border>

            <!-- 3. MultiDataTrigger -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}"
                               Text="{Binding [Triggers_3Title], Source={x:Static loc:Localizer.Instance}}"/>
                    <TextBlock Style="{StaticResource Label}"
                               Text="{Binding [Triggers_3Hint], Source={x:Static loc:Localizer.Instance}}"/>
                    <CheckBox IsChecked="{Binding IsBold}"
                              Content="{Binding [Triggers_Bold], Source={x:Static loc:Localizer.Instance}}"
                              Margin="0,6,0,2"/>
                    <CheckBox IsChecked="{Binding IsItalic}"
                              Content="{Binding [Triggers_Italic], Source={x:Static loc:Localizer.Instance}}"/>

                    <Border Margin="0,12,0,0" Padding="16" CornerRadius="6"
                            Width="300" HorizontalAlignment="Left">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#F5F5F5"/>
                                <Style.Triggers>
                                    <!-- Срабатывает только когда ОБА условия True -->
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsBold}" Value="True"/>
                                            <Condition Binding="{Binding IsItalic}" Value="True"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Background" Value="#CE93D8"/>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock HorizontalAlignment="Center" FontSize="16"
                                   Text="{Binding [Triggers_Sample], Source={x:Static loc:Localizer.Instance}}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontWeight" Value="Normal"/>
                                    <Setter Property="FontStyle" Value="Normal"/>
                                    <Setter Property="Foreground" Value="#212121"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsBold}" Value="True">
                                            <Setter Property="FontWeight" Value="Bold"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsItalic}" Value="True">
                                            <Setter Property="FontStyle" Value="Italic"/>
                                        </DataTrigger>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsBold}" Value="True"/>
                                                <Condition Binding="{Binding IsItalic}" Value="True"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Foreground" Value="White"/>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
