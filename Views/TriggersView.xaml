<UserControl x:Class="BindingsAndTriggers.Views.TriggersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:BindingsAndTriggers.Views">

    <UserControl.Resources>
        <local:ScoreConverter x:Key="ScoreConv"/>

        <!-- Trigger: меняет фон Border при наведении мыши -->
        <Style x:Key="HoverCard" TargetType="Border">
            <Setter Property="Background" Value="#E8EAF6"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#3F51B5"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
        <StackPanel MaxWidth="700" HorizontalAlignment="Left">

            <TextBlock Style="{StaticResource PageTitle}" Text="Триггеры (Triggers)"/>

            <!-- Описание -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}" Text="Виды триггеров в WPF"/>
                    <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" LineHeight="22">
                        • Trigger — реагирует на свойство самого элемента (IsMouseOver, IsFocused)&#10;
                        • DataTrigger — реагирует на значение привязки к ViewModel&#10;
                        • MultiDataTrigger — срабатывает при нескольких условиях одновременно
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- 1. Trigger -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}" Text="1. Trigger — свойство элемента"/>
                    <TextBlock Style="{StaticResource Label}"
                               Text="Наведите мышь на карточку — Trigger реагирует на IsMouseOver:"/>
                    <Border Style="{StaticResource HoverCard}" Width="280"
                            HorizontalAlignment="Left" Margin="0,8,0,0">
                        <TextBlock HorizontalAlignment="Center" FontSize="14">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#3F51B5"/>
                                    <Setter Property="Text" Value="Наведите курсор сюда"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMouseOver,
                                            RelativeSource={RelativeSource AncestorType=Border}}"
                                                     Value="True">
                                            <Setter Property="Foreground" Value="White"/>
                                            <Setter Property="Text" Value="Trigger сработал! ✓"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>
                </StackPanel>
            </Border>

            <!-- 2. DataTrigger -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}" Text="2. DataTrigger — значение из ViewModel"/>
                    <TextBlock Style="{StaticResource Label}"
                               Text="Введите слово «ошибка» — DataTrigger изменит оформление:"/>
                    <TextBox Text="{Binding InputText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Width="300" HorizontalAlignment="Left"/>

                    <Border Margin="0,10,0,0" Padding="12" CornerRadius="6"
                            Width="300" HorizontalAlignment="Left">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#E8F5E9"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding InputText}" Value="ошибка">
                                        <Setter Property="Background" Value="#FFEBEE"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock HorizontalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="✓ Всё в порядке"/>
                                    <Setter Property="Foreground" Value="#2E7D32"/>
                                    <Setter Property="FontWeight" Value="Normal"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding InputText}" Value="ошибка">
                                            <Setter Property="Text" Value="✗ Обнаружена ошибка!"/>
                                            <Setter Property="Foreground" Value="#C62828"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>

                    <!-- DataTrigger + конвертер -->
                    <TextBlock Style="{StaticResource Label}" Margin="0,16,0,4"
                               Text="DataTrigger + конвертер: оценка меняет цвет бейджа:"/>
                    <Slider Minimum="0" Maximum="100"
                            Value="{Binding Score, Mode=TwoWay}"
                            Width="300" HorizontalAlignment="Left"/>
                    <Border Padding="10,6" CornerRadius="4" Margin="0,8,0,0"
                            Width="160" HorizontalAlignment="Left">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#43A047"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Score, Converter={StaticResource ScoreConv}}"
                                                 Value="low">
                                        <Setter Property="Background" Value="#E53935"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Score, Converter={StaticResource ScoreConv}}"
                                                 Value="mid">
                                        <Setter Property="Background" Value="#FB8C00"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Foreground="White" FontWeight="Bold" HorizontalAlignment="Center">
                            <Run Text="{Binding Score, StringFormat={}{0:F0}, Mode=OneWay}"/>
                            <Run Text=" баллов"/>
                        </TextBlock>
                    </Border>
                </StackPanel>
            </Border>

            <!-- 3. MultiDataTrigger -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}" Text="3. MultiDataTrigger — несколько условий"/>
                    <TextBlock Style="{StaticResource Label}"
                               Text="Отметьте оба флажка одновременно — сработает MultiDataTrigger:"/>
                    <CheckBox IsChecked="{Binding IsBold}" Content="Жирный" Margin="0,6,0,2"/>
                    <CheckBox IsChecked="{Binding IsItalic}" Content="Курсив"/>

                    <Border Margin="0,12,0,0" Padding="16" CornerRadius="6"
                            Width="300" HorizontalAlignment="Left">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#F5F5F5"/>
                                <Style.Triggers>
                                    <!-- Срабатывает только когда ОБА условия True -->
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsBold}" Value="True"/>
                                            <Condition Binding="{Binding IsItalic}" Value="True"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Background" Value="#CE93D8"/>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="Образец текста" HorizontalAlignment="Center" FontSize="16">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontWeight" Value="Normal"/>
                                    <Setter Property="FontStyle" Value="Normal"/>
                                    <Setter Property="Foreground" Value="#212121"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsBold}" Value="True">
                                            <Setter Property="FontWeight" Value="Bold"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsItalic}" Value="True">
                                            <Setter Property="FontStyle" Value="Italic"/>
                                        </DataTrigger>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsBold}" Value="True"/>
                                                <Condition Binding="{Binding IsItalic}" Value="True"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Foreground" Value="White"/>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
