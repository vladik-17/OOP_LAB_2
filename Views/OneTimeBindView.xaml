<UserControl x:Class="BindingsAndTriggers.Views.OneTimeBindView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
        <StackPanel MaxWidth="700" HorizontalAlignment="Left">

            <TextBlock Style="{StaticResource PageTitle}" Text="{DynamicResource OneTime_Title}"/>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}" Text="{DynamicResource OneTime_HowTitle}"/>
                    <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}"
                               Text="{DynamicResource OneTime_HowDesc}"/>
                </StackPanel>
            </Border>

            <!-- Сравнение OneTime vs OneWay -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}" Text="{DynamicResource OneTime_CompareTitle}"/>
                    <TextBlock Style="{StaticResource Label}" Text="{DynamicResource OneTime_CompareHint}"/>

                    <TextBlock Style="{StaticResource SubTitle}" Margin="0,12,0,4"
                               Text="{DynamicResource OneTime_Label}"/>
                    <TextBlock Style="{StaticResource ResultText}"
                               Text="{Binding DynamicText, Mode=OneTime}"
                               Foreground="#E53935"/>

                    <TextBlock Style="{StaticResource SubTitle}" Margin="0,12,0,4"
                               Text="{DynamicResource OneWay_CompareLabel}"/>
                    <TextBlock Style="{StaticResource ResultText}"
                               Text="{Binding DynamicText, Mode=OneWay}"
                               Foreground="#43A047"/>

                    <Button Style="{StaticResource PrimaryButton}"
                            Command="{Binding ReloadCommand}"
                            Content="{DynamicResource OneTime_Button}"
                            HorizontalAlignment="Left"
                            Margin="0,16,0,0"/>
                </StackPanel>
            </Border>

            <!-- Когда использовать -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}" Text="{DynamicResource OneTime_WhenTitle}"/>
                    <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" LineHeight="22"
                               Text="{DynamicResource OneTime_WhenDesc}"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
