<UserControl x:Class="BindingsAndTriggers.Views.OneTimeBindView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:BindingsAndTriggers.Localization">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
        <StackPanel MaxWidth="700" HorizontalAlignment="Left">

            <TextBlock Style="{StaticResource PageTitle}"
                       Text="{Binding [OneTime_Title], Source={x:Static loc:Localizer.Instance}}"/>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}"
                               Text="{Binding [OneTime_HowTitle], Source={x:Static loc:Localizer.Instance}}"/>
                    <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}"
                               Text="{Binding [OneTime_HowDesc], Source={x:Static loc:Localizer.Instance}}"/>
                </StackPanel>
            </Border>

            <!-- Сравнение OneTime vs OneWay -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}"
                               Text="{Binding [OneTime_CompareTitle], Source={x:Static loc:Localizer.Instance}}"/>
                    <TextBlock Style="{StaticResource Label}"
                               Text="{Binding [OneTime_CompareHint], Source={x:Static loc:Localizer.Instance}}"/>

                    <TextBlock Style="{StaticResource SubTitle}" Margin="0,12,0,4"
                               Text="{Binding [OneTime_Label], Source={x:Static loc:Localizer.Instance}}"/>
                    <TextBlock Style="{StaticResource ResultText}"
                               Text="{Binding DynamicText, Mode=OneTime}"
                               Foreground="#E53935"/>

                    <TextBlock Style="{StaticResource SubTitle}" Margin="0,12,0,4"
                               Text="{Binding [OneWay_CompareLabel], Source={x:Static loc:Localizer.Instance}}"/>
                    <TextBlock Style="{StaticResource ResultText}"
                               Text="{Binding DynamicText, Mode=OneWay}"
                               Foreground="#43A047"/>

                    <Button Style="{StaticResource PrimaryButton}"
                            Command="{Binding ReloadCommand}"
                            Content="{Binding [OneTime_Button], Source={x:Static loc:Localizer.Instance}}"
                            HorizontalAlignment="Left"
                            Margin="0,16,0,0"/>
                </StackPanel>
            </Border>

            <!-- Когда использовать -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}"
                               Text="{Binding [OneTime_WhenTitle], Source={x:Static loc:Localizer.Instance}}"/>
                    <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" LineHeight="22"
                               Text="{Binding [OneTime_WhenDesc], Source={x:Static loc:Localizer.Instance}}"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
