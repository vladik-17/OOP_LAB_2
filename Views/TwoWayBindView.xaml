<UserControl x:Class="BindingsAndTriggers.Views.TwoWayBindView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
        <StackPanel MaxWidth="700" HorizontalAlignment="Left">

            <TextBlock Style="{StaticResource PageTitle}" Text="{DynamicResource TwoWay_Title}"/>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}" Text="{DynamicResource TwoWay_HowTitle}"/>
                    <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}"
                               Text="{DynamicResource TwoWay_HowDesc}"/>
                </StackPanel>
            </Border>

            <!-- Два TextBox — одно свойство -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}" Text="{DynamicResource TwoWay_MultiTitle}"/>
                    <TextBlock Style="{StaticResource Label}" Text="{DynamicResource TwoWay_MultiHint}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding SharedText, Mode=TwoWay}"
                                 ToolTip="{DynamicResource TwoWay_Field1}"/>
                        <TextBox Grid.Column="2" Text="{Binding SharedText, Mode=TwoWay}"
                                 ToolTip="{DynamicResource TwoWay_Field2}"/>
                    </Grid>
                    <TextBlock Style="{StaticResource Label}" Margin="0,10,0,4"
                               Text="{DynamicResource TwoWay_VMValue}"/>
                    <TextBlock Style="{StaticResource ResultText}"
                               Text="{Binding SharedText, Mode=OneWay}" FontWeight="SemiBold"/>
                </StackPanel>
            </Border>

            <!-- Slider ↔ TextBox -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}" Text="{DynamicResource TwoWay_SliderTitle}"/>
                    <TextBlock Style="{StaticResource Label}" Text="{DynamicResource TwoWay_SliderHint}"/>
                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="80"/>
                        </Grid.ColumnDefinitions>
                        <Slider Grid.Column="0" Minimum="-30" Maximum="50"
                                Value="{Binding Temperature, Mode=TwoWay}"
                                VerticalAlignment="Center"/>
                        <TextBox Grid.Column="2"
                                 Text="{Binding Temperature, Mode=TwoWay, StringFormat=F1}"
                                 TextAlignment="Center"/>
                    </Grid>
                    <TextBlock Margin="0,10,0,0" FontSize="16" FontWeight="Bold"
                               Foreground="{StaticResource PrimaryBrush}"
                               Text="{Binding Temperature, StringFormat={}{0:F1}, Mode=OneWay}"/>
                </StackPanel>
            </Border>

            <!-- ComboBox с цветом -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}" Text="{DynamicResource TwoWay_ComboTitle}"/>
                    <TextBlock Style="{StaticResource Label}" Text="{DynamicResource TwoWay_ComboHint}"/>
                    <ComboBox ItemsSource="{Binding Colors}"
                              SelectedItem="{Binding SelectedColor, Mode=TwoWay}"
                              Width="200" HorizontalAlignment="Left"/>
                    <Border Margin="0,12,0,0" Width="200" Height="50"
                            CornerRadius="6" HorizontalAlignment="Left">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#E53935"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedColor}" Value="Красный">
                                        <Setter Property="Background" Value="#E53935"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding SelectedColor}" Value="Зелёный">
                                        <Setter Property="Background" Value="#43A047"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding SelectedColor}" Value="Синий">
                                        <Setter Property="Background" Value="#1E88E5"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding SelectedColor}" Value="Жёлтый">
                                        <Setter Property="Background" Value="#FDD835"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding SelectedColor}" Value="Фиолетовый">
                                        <Setter Property="Background" Value="#8E24AA"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                                   FontWeight="Bold" FontSize="14">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="White"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedColor}" Value="Жёлтый">
                                            <Setter Property="Foreground" Value="#333333"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                            <Run Text="{Binding SelectedColor, Mode=OneWay}"/>
                        </TextBlock>
                    </Border>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
